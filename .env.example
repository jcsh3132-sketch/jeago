# Local SQLite copy, prepared by npm run db:prepare
DATABASE_URL=file:instance/inventory-next.db
# For a remote libSQL/Turso database on Vercel:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=
# Vercel Marketplace Turso integration automatically supplies:
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Server-only AES-256-GCM key (64 hex characters) for company marketplace API keys.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back up securely; changing it prevents decryption of saved company API credentials.
# CALCULATOR_API_ENCRYPTION_KEY=
